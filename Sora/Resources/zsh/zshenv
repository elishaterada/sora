# Sora interactive bootstrap. ZDOTDIR points here so this file runs first.
# Source Ghostty's integration (do not copy it), then replace the stock macOS
# prompt with an empty one so only the blinking bar cursor marks input.
# Custom themes that change PS1 in .zshrc are left alone.

_sora_dir="${${(%):-%x}:A:h}"

if [[ -n "${GHOSTTY_RESOURCES_DIR}" && -r "${GHOSTTY_RESOURCES_DIR}/shell-integration/zsh/.zshenv" ]]; then
  builtin source "${GHOSTTY_RESOURCES_DIR}/shell-integration/zsh/.zshenv"
fi

if [[ -o interactive ]]; then
  export CLICOLOR=1
  export COLORTERM="${COLORTERM:-truecolor}"

  _sora_simplify_prompt() {
    builtin emulate -L zsh
    # Literal template from /etc/zshrc, not the expanded prompt.
    if [[ "${PS1}" == '%n@%m %1~ %# ' ]]; then
      PS1=''
    fi
    precmd_functions=(${precmd_functions:#_sora_simplify_prompt})
    builtin unfunction _sora_simplify_prompt
  }
  typeset -ag precmd_functions
  precmd_functions=(_sora_simplify_prompt ${precmd_functions[@]})

  if [[ -r "${_sora_dir}/prompt-line.zsh" ]]; then
    builtin source "${_sora_dir}/prompt-line.zsh"
  fi
  if [[ -r "${_sora_dir}/highlight.zsh" ]]; then
    builtin source "${_sora_dir}/highlight.zsh"
  fi
  if [[ -r "${_sora_dir}/command-blocks.zsh" ]]; then
    builtin source "${_sora_dir}/command-blocks.zsh"
  fi
fi
