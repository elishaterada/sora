# Panda (default) — https://terminalcolors.com/themes/panda/default/
background = #14161a
background-opacity = 0.18
background-blur = macos-glass-regular
foreground = #cccccc
cursor-color = #19f9d8
cursor-text = #292a2b
cursor-style = bar
# Built-in blink. Soft custom-shader blink was tried earlier but Ghostty
# loads shaders via cwd.openFile; a failed load left blink=false and a solid
# caret with no fallback. Prefer the reliable path.
cursor-style-blink = true
# Thin bar matching the SwiftUI TextField caret in agent mode (was 4).
adjust-cursor-thickness = 1
selection-background = #5f4e3b
selection-foreground = #cccccc
window-padding-x = 24
window-padding-y = 18
window-padding-balance = false
# Extend each block surface through the inset; only its text is padded.
window-padding-color = extend-always
adjust-cell-height = 12%
semantic-prompt-boundaries = true
smooth-scrolling = true
font-size = 18
font-family = "SF Mono"
bold-color = bright
window-theme = system

palette = 0=#000000
palette = 1=#ff2c6d
palette = 2=#19f9d8
palette = 3=#ffb86c
palette = 4=#45a9f9
palette = 5=#ff75b5
palette = 6=#b084eb
palette = 7=#cdcdcd
palette = 8=#757575
palette = 9=#ff2c6d
palette = 10=#19f9d8
palette = 11=#ffcc95
palette = 12=#6fc1ff
palette = 13=#ff9ac1
palette = 14=#bcaafe
palette = 15=#e6e6e6
