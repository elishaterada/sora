# Panda (default) — https://terminalcolors.com/themes/panda/default/
background = #292a2b
background-opacity = 0.20
background-blur = macos-glass-regular
foreground = #cccccc
cursor-color = #cccccc
cursor-text = #292a2b
cursor-style = bar
cursor-style-blink = false
selection-background = #5f4e3b
selection-foreground = #cccccc
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
adjust-cell-height = 12%
font-size = 18
font-family = "SF Mono"
bold-color = bright
window-theme = system

palette = 0=#000000
palette = 1=#ff2c6d
palette = 2=#19f9d8
palette = 3=#ffb86c
palette = 4=#45a9f9
palette = 5=#ff75b5
palette = 6=#b084eb
palette = 7=#cdcdcd
palette = 8=#757575
palette = 9=#ff2c6d
palette = 10=#19f9d8
palette = 11=#ffcc95
palette = 12=#6fc1ff
palette = 13=#ff9ac1
palette = 14=#bcaafe
palette = 15=#e6e6e6
