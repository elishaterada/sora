+/// Read-only context for a sticky command header. Signed source coordinates
+/// let the native view pin the original command continuously as it scrolls.
+/// Unlike selectable completed blocks, the last running command is eligible.
+const StickyCommand = struct { command: Selection, remaining_rows: f64, source_rows: f64 };
