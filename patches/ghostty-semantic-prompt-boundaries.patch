+/// Draw a one-pixel rule above each primary semantic prompt except at row zero.
+/// The row metadata is owned by the terminal, so these rules automatically
+/// follow reflow and scrollback and disappear when the screen is cleared.
+fn drawCommandBoundaries(
+    self: *Overlay,
+    alloc: Allocator,
+    state: *const terminal.RenderState,
+) void {
+    const row_raw = state.row_data.slice().items(.raw);
+    if (row_raw.len < 2) return;
+    const color = (z2d.pixel.RGBA{
+        .r = 255,
+        .g = 255,
+        .b = 255,
+        .a = 85,
+    }).multiply().asPixel();
+
+    var last_prompt: usize = 0;
+    for (row_raw, 0..) |row, y| {
+        if (row.semantic_prompt == .prompt) last_prompt = y;
+    }
+    const row_cells = state.row_data.slice().items(.cells);
+    for (row_raw[1..], 1..) |row, y| {
+        if (!isCommandBoundary(y, row.semantic_prompt == .prompt)) continue;
+        // Empty submissions and cancelled prompts are not command blocks.
+        // Keep the live boundary, but omit abandoned empty prompt rows.
+        if (y != last_prompt) {
+            var has_text = false;
+            for (row_cells[y].slice().items(.raw)) |cell| {
+                if (cell.codepoint() > 32) {
+                    has_text = true;
+                    break;
+                }
+            }
+            if (!has_text) continue;
+        }
+        self.drawHorizontalHairline(alloc, y, y != last_prompt, color) catch |err| {
+            log.warn("Error drawing command boundary: {}", .{err});
+        };
+    }
+}
+
+fn isCommandBoundary(
+    y: usize,
+    starts_primary_prompt: bool,
+) bool {
+    return y > 0 and starts_primary_prompt;
+}
+
+fn drawHorizontalHairline(
+    self: *Overlay,
+    alloc: Allocator,
+    y: usize,
+    command_padding: bool,
+    color: z2d.Pixel,
+) !void {
+    const width: f64 = @floatFromInt(self.surface.getWidth());
+    const row_top = try std.math.mul(
+        usize,
+        y,
+        self.cell_size.height,
+    );
+    const padded_y = try std.math.sub(
+        usize,
+        row_top,
+        if (command_padding) self.cell_size.height / 2 + 1 else 1,
+    );
+    const pixel_y: f64 = @floatFromInt(
+        std.math.cast(i32, padded_y) orelse return error.Overflow,
+    );
+
+    var ctx: z2d.Context = .init(global.io(), alloc, &self.surface);
+    defer ctx.deinit();
+    ctx.setAntiAliasingMode(.none);
+    ctx.setSourceToPixel(color);
+    try ctx.moveTo(0, pixel_y);
+    try ctx.lineTo(width, pixel_y);
+    try ctx.lineTo(width, pixel_y + 1);
+    try ctx.lineTo(0, pixel_y + 1);
+    try ctx.closePath();
+    try ctx.fill();
+}
