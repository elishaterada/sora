 /// The default is `keystroke, no-output`.
 @"scroll-to-bottom": ScrollToBottom = .default,
 
+/// Draw a subtle horizontal boundary above primary semantic prompts. This relies
+/// on shell integration (OSC 133) and is intended for block-oriented terminal
+/// hosts that want command output groups to remain legible through reflow,
+/// scrolling, and screen clearing.
+@"semantic-prompt-boundaries": bool = false,
