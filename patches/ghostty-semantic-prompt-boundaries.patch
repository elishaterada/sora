+/// Hit testing follows the highlight: the leading spacer belongs to the next
+/// block, including the unselectable live input region.
+pub fn commandBlockAtVisual(self: *Screen, pin: Pin) ?Selection {
+    if (pin.down(1)) |next| {
+        if (next.rowAndCell().row.semantic_prompt == .prompt and
+            commandBlockBoundary(next).eql(pin.left(pin.x)))
