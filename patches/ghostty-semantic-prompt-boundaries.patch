+    pages.scrollPrecise(0.375);
+    try state.update(alloc, &t);
+    try testing.expectEqual(end, pages.scrollbar().offset);
+    try testing.expectEqual(@as(f64, 0), state.viewport_fraction);
+    try testing.expectEqual(@as(usize, 5), state.rows);
+
+    // No overscroll debt: the next movement responds immediately at both ends.
+    pages.scrollPrecise(-100_000);
+    pages.scrollPrecise(0.125);
+    try testing.expectEqual(@as(usize, 0), pages.scrollbar().offset);
+    try testing.expectEqual(@as(f64, 0.125), pages.scrollFraction());
+    pages.scrollPrecise(100_000);
+    pages.scrollPrecise(-0.125);
