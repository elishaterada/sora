+
+/// Rendering can shift the highlight to divider boundaries without changing
+/// the tracked range used to navigate, copy, or reuse the selected command.
+pub fn renderSelection(self: *Screen) ?Selection {
+    const selected = self.selection orelse return null;
+    if (!self.command_block_selected) return selected;
+    const start = selected.start();
+    var end = selected.end();
+    if (start.garbage or end.garbage) return null;
+    if (end.down(1)) |next| {
+        const boundary = commandBlockBoundary(next);
+        if (boundary.eql(end.left(end.x))) {
