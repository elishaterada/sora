diff --git a/src/renderer/Overlay.zig b/src/renderer/Overlay.zig
index 46a75be8e..ef51ff02f 100644
--- a/src/renderer/Overlay.zig
+++ b/src/renderer/Overlay.zig
@@ -70,6 +70,7 @@ cell_size: CellSize,
 pub const Feature = union(enum) {
     highlight_hyperlinks,
     semantic_prompts,
+    command_boundaries,
 };
 
 pub const InitError = Allocator.Error || error{
@@ -144,9 +145,78 @@ pub fn applyFeatures(
             alloc,
             state,
         ),
+        .command_boundaries => self.drawCommandBoundaries(
+            alloc,
+            state,
+        ),
     };
 }
 
+/// Draw a one-pixel rule above each primary semantic prompt except at row zero.
+/// The row metadata is owned by the terminal, so these rules automatically
+/// follow reflow and scrollback and disappear when the screen is cleared.
+fn drawCommandBoundaries(
+    self: *Overlay,
+    alloc: Allocator,
+    state: *const terminal.RenderState,
+) void {
+    const row_raw = state.row_data.slice().items(.raw);
+    if (row_raw.len < 2) return;
+    const color = (z2d.pixel.RGBA{
+        .r = 255,
+        .g = 255,
+        .b = 255,
+        .a = 72,
+    }).multiply().asPixel();
+
+    for (row_raw[1..], 1..) |row, y| {
+        if (!isCommandBoundary(y, row.semantic_prompt == .prompt)) continue;
+        self.drawHorizontalHairline(alloc, y, color) catch |err| {
+            log.warn("Error drawing command boundary: {}", .{err});
+        };
+    }
+}
+
+fn isCommandBoundary(
+    y: usize,
+    starts_primary_prompt: bool,
+) bool {
+    return y > 0 and starts_primary_prompt;
+}
+
+fn drawHorizontalHairline(
+    self: *Overlay,
+    alloc: Allocator,
+    y: usize,
+    color: z2d.Pixel,
+) !void {
+    const width: f64 = @floatFromInt(self.surface.getWidth());
+    const row_top = try std.math.mul(
+        usize,
+        y,
+        self.cell_size.height,
+    );
+    const padded_y = try std.math.sub(
+        usize,
+        row_top,
+        self.cell_size.height / 2,
+    );
+    const pixel_y: f64 = @floatFromInt(
+        std.math.cast(i32, padded_y) orelse return error.Overflow,
+    );
+
+    var ctx: z2d.Context = .init(global.io(), alloc, &self.surface);
+    defer ctx.deinit();
+    ctx.setAntiAliasingMode(.none);
+    ctx.setSourceToPixel(color);
+    try ctx.moveTo(0, pixel_y);
+    try ctx.lineTo(width, pixel_y);
+    try ctx.lineTo(width, pixel_y + 1);
+    try ctx.lineTo(0, pixel_y + 1);
+    try ctx.closePath();
+    try ctx.fill();
+}
+
 /// Add rectangles around contiguous hyperlinks in the render state.
 ///
 /// Note: this currently doesn't take into account unique hyperlink IDs
@@ -414,3 +484,10 @@ fn highlightPixelRect(
     ctx.setSourceToPixel(border_color);
     try ctx.stroke();
 }
+
+test "command boundaries follow primary prompts below the first row" {
+    const testing = std.testing;
+    try testing.expect(!isCommandBoundary(0, true));
+    try testing.expect(isCommandBoundary(1, true));
+    try testing.expect(!isCommandBoundary(1, false));
+}
