+
+pub fn stickyCommandFollowing(self: *Screen, following: bool) ?StickyCommand {
+    if (!self.semantic_prompt.seen) return null;
+    const top = self.pages.getTopLeft(.viewport);
+    var previous = top.promptIterator(.left_up, null);
+    var start = previous.next() orelse return null;
+    if (start.rowAndCell().row.semantic_prompt != .prompt) return null;
+    var next = start.promptIterator(.right_down, null);
+    _ = next.next();
+    if (following) start = next.next() orelse return null;
+    const after = next.next();
+    if (after == null and self.cursor.semantic_content != .output) return null;
+    var end = if (after) |p| p.up(1) orelse return null else self.cursor.page_pin.*;
+    end.x = end.node.cols() - 1;
+    const command = self.commandBlockContent(.init(start, end, false), true) orelse return null;
+    const source = self.pages.pointFromPin(.screen, command.start()) orelse return null;
+    const viewport = self.pages.pointFromPin(.screen, top) orelse return null;
+    const source_rows = @as(f64, @floatFromInt(source.screen.y)) -
+        @as(f64, @floatFromInt(viewport.screen.y)) - self.pages.scrollFraction();
+    const boundary = after orelse end;
+    const distance = self.pages.pointFromPin(.viewport, boundary) orelse return null;
+    const remaining = @as(f64, @floatFromInt(distance.viewport.y)) - self.pages.scrollFraction();
+    if (remaining <= 0) return null;
+    return .{ .command = command, .remaining_rows = remaining, .source_rows = source_rows };
+}
+
+pub fn selectCommandBlock(self: *Screen, block: Selection) Allocator.Error!void {
+    try self.select(block);
+    self.command_block_selected = true;
