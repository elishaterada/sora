+    /// Sora's native block controls use the same tracked selections as mouse
+    /// selection, so scrollback eviction, reflow, and clear retain ownership.
+    export fn ghostty_surface_navigate_command_block(
+        surface: *Surface,
+        direction: c_int,
+        from_selection: bool,
+    ) c_int {
+        const core = &surface.core_surface;
+        core.renderer_state.mutex.lockUncancelable(global.io());
+        defer core.renderer_state.mutex.unlock(global.io());
+        const t = &core.io.terminal;
+        if (t.screens.active_key == .alternate) return -1;
+        const screen = t.screens.active;
+        if (!screen.semantic_prompt.seen) return -1;
+        const from = if (from_selection)
+            (screen.selection orelse return -1).start()
+        else
+            screen.cursor.page_pin.*;
+        if (from.garbage) return -1;
+        const block = screen.adjacentCommandBlock(from, direction < 0) orelse {
+            if (!from_selection) return -1;
+            if (direction < 0) return 1; // Stay on the oldest retained block.
+            screen.clearSelection();
+            t.scrollViewport(.{ .bottom = {} });
+            surface.refresh();
+            return 0;
+        };
+        screen.selectCommandBlock(block) catch return -1;
+        screen.scroll(.{ .pin = terminal.Screen.commandBlockBoundary(block.start()) });
+        surface.refresh();
+        return 1;
+    }
+
+    export fn ghostty_surface_select_command_block_at(surface: *Surface, x: f64, y: f64) bool {
+        const core = &surface.core_surface;
+        core.renderer_state.mutex.lockUncancelable(global.io());
+        defer core.renderer_state.mutex.unlock(global.io());
+        if (core.io.terminal.screens.active_key == .alternate) return false;
+        const screen = core.io.terminal.screens.active;
+        const pixels = surface.cursorPosToPixels(.{ .x = @floatCast(x), .y = @floatCast(y) }) catch return false;
+        const pin = screen.pages.pin(.{ .viewport = core.posToViewport(pixels.x, pixels.y) }) orelse return false;
+        const block = screen.commandBlockAtVisual(pin) orelse return false;
+        screen.selectCommandBlock(block) catch return false;
+        surface.refresh();
+        return true;
+    }
+
+    export fn ghostty_surface_read_command_block(surface: *Surface, command: bool, result: *Text) bool {
+        const core = &surface.core_surface;
+        core.renderer_state.mutex.lockUncancelable(global.io());
+        defer core.renderer_state.mutex.unlock(global.io());
+        if (core.io.terminal.screens.active_key == .alternate) return false;
+        const screen = core.io.terminal.screens.active;
+        const selected = screen.selection orelse return false;
+        if (selected.start().garbage) return false;
+        const block = screen.commandBlockAt(selected.start()) orelse return false;
+        const content = screen.commandBlockContent(block, command) orelse return false;
+        return readTextLocked(surface, content, result);
+    }
+
+    /// Snapshot the command above the viewport without changing selection,
+    /// focus, scroll position, or PTY dimensions. Distance is in backing pixels.
+    export fn ghostty_surface_read_sticky_command(surface: *Surface, following: bool, result: *Text, remaining_px: *f64, source_px: *f64, failed: *bool) bool {
+        const core = &surface.core_surface;
+        core.renderer_state.mutex.lockUncancelable(global.io());
+        defer core.renderer_state.mutex.unlock(global.io());
+        if (core.io.terminal.screens.active_key == .alternate) return false;
+        const context = core.io.terminal.screens.active.stickyCommandFollowing(following) orelse return false;
+        failed.* = context.command.start().rowAndCell().row.command_failed;
+        source_px.* = context.source_rows * @as(f64, @floatFromInt(core.size.cell.height)) +
+            @as(f64, @floatFromInt(core.size.padding.top));
+        remaining_px.* = context.remaining_rows * @as(f64, @floatFromInt(core.size.cell.height)) +
+            @as(f64, @floatFromInt(core.size.padding.top));
+        // Preserve the terminal's actual cell styling, resolving palette colors.
+        const t = &core.io.terminal;
+        var writer: std.Io.Writer.Allocating = .init(global.alloc());
+        defer writer.deinit();
+        var formatter: terminal.formatter.ScreenFormatter = .init(t.screens.active, .{
+            .emit = .vt,
+            .unwrap = true,
+            .foreground = t.colors.foreground.get(),
+            .palette = &t.colors.palette.current,
+        });
+        formatter.content = .{ .selection = context.command };
+        formatter.format(&writer.writer) catch return false;
+        const text = writer.toOwnedSliceSentinel(0) catch return false;
+        result.* = .{
+            .tl_px_x = -1,
+            .tl_px_y = -1,
+            .offset_start = 0,
+            .offset_len = 0,
+            .text = text.ptr,
+            .text_len = text.len,
+        };
+        return true;
+    }
+
+    export fn ghostty_surface_clear_command_block(surface: *Surface) void {
+        const core = &surface.core_surface;
+        core.renderer_state.mutex.lockUncancelable(global.io());
+        defer core.renderer_state.mutex.unlock(global.io());
+        core.io.terminal.screens.active.clearSelection();
+        surface.refresh();
+    }
+
+    export fn ghostty_surface_set_native_input(surface: *Surface, enabled: bool) void {
+        const core = &surface.core_surface;
+        core.renderer_state.mutex.lockUncancelable(global.io());
+        defer core.renderer_state.mutex.unlock(global.io());
+        if (core.io.terminal.flags.sora_native_input == enabled) return;
+        core.io.terminal.flags.sora_native_input = enabled;
+        core.io.terminal.flags.dirty.clear = true;
+        surface.refresh();
+    }
