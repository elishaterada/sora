+test "command boundaries follow primary prompts below the first row" {
+    const testing = std.testing;
+    try testing.expect(!isCommandBoundary(0, true));
+    try testing.expect(isCommandBoundary(1, true));
+    try testing.expect(!isCommandBoundary(1, false));
+}
