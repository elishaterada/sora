+    try testing.expectEqual(end - 1, pages.scrollbar().offset);
+    try testing.expectEqual(@as(f64, 0.75), state.viewport_fraction);
+    try testing.expectEqual(@as(usize, 6), state.rows);
+    try testing.expectEqual(@as(usize, 5), pages.rows);
+    const guard_row = pages.getTopLeft(.viewport).down(5).?;
+    try testing.expect(state.row_data.items(.pin)[5].eql(guard_row));
+
+    state.dirty = .false;
+    for (state.row_data.items(.dirty)) |*dirty| dirty.* = false;
+    pages.scrollPrecise(-0.125);
+    try state.update(alloc, &t);
+    try testing.expectEqual(@as(f64, 0.625), state.viewport_fraction);
+    try testing.expectEqual(RenderState.Dirty.partial, state.dirty);
+    for (state.row_data.items(.dirty)) |dirty| try testing.expect(!dirty);
+
