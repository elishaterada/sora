+pub fn adjacentCommandBlock(self: *Screen, from: Pin, older: bool) ?Selection {
+    if (!self.semantic_prompt.seen) return null;
+    var it = from.promptIterator(if (older) .left_up else .right_down, null);
+    _ = it.next(); // Skip the current block or live prompt.
