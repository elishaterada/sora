+/// A completed command group. All bounds come from OSC 133 metadata, never
+/// text matching. The next primary prompt closes the group; a live draft is
+/// deliberately ineligible. Selection pins are tracked by Screen.select.
+pub fn commandBlockAt(self: *Screen, pin: Pin) ?Selection {
+    if (!self.semantic_prompt.seen) return null;
+    var previous = pin.promptIterator(.left_up, null);
+    const start = previous.next() orelse return null;
+    if (start.rowAndCell().row.semantic_prompt != .prompt) return null;
+    var next = start.promptIterator(.right_down, null);
+    _ = next.next();
+    const after = next.next() orelse return null;
+    const input = self.pages.highlightSemanticContent(start, .input) orelse return null;
+    var cells = input.start.cellIterator(.right_down, input.end);
+    while (cells.next()) |cell| {
+        if (cell.rowAndCell().cell.hasText()) break;
+    } else return null;
+    var end = after.up(1) orelse return null;
+    end.x = end.node.cols() - 1;
+    return .init(start.left(start.x), end, false);
+}
+
+/// Share the blank row before a primary prompt with that prompt's block.
+/// Never borrow a row containing output or part of a wrapped command.
+pub fn commandBlockBoundary(prompt: Pin) Pin {
+    if (prompt.rowAndCell().row.semantic_prompt != .prompt) return prompt;
+    const previous = prompt.up(1) orelse return prompt;
+    if (previous.rowAndCell().row.wrap) return prompt;
+    for (previous.cells(.all)) |cell| {
+        if (cell.codepoint() > 32) return prompt;
+    }
+    return previous.left(previous.x);
